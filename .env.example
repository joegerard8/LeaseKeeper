# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cheapest Gemini tier available. Verify against Google's current model
# list/pricing before a real demo; this is only a default.
GEMINI_MODEL=gemini-flash-lite-latest
